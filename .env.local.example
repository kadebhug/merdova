# Supabase Configuration
# Copy this file and rename to .env.local
# Replace the values below with your actual Supabase credentials

# Get these from your Supabase project dashboard:
# Settings > API > Project URL and anon/public key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_FIREBASE_FUNCTIONS_URL=your-funtion-url

# FTP Password (required)
FTP_PASSWORD=your_ftp_password_here

# FTP Remote Directory (optional, defaults to public_html)
FTP_REMOTE_DIR=public_html
